/* ====== BLUE ROUNDED STYLE ====== */

* {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 13px;
    color: #2C3E50;
}

QMainWindow {
    background-color: #ECF0F1;
}

QWidget#page, QWidget#page_2 {
    background-color: #FFFFFF;
    border: 1px solid #BDC3C7;
}

/* ====== BLUE ROUNDED BUTTONS ====== */
QPushButton {
    background-color: #3498DB;
    color: white;
    padding: 10px 20px;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #2980B9;
}

QPushButton:pressed {
    background-color: #21618C;
}

/* ====== ROUNDED INPUT ====== */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #BDC3C7;
    padding: 8px 12px;
    color: #2C3E50;
    border-radius: 6px;
}

QLineEdit:focus {
    border: 1px solid #3498DB;
}

/* ====== ROUNDED PROGRESS BAR ====== */
QProgressBar {
    border: 1px solid #BDC3C7;
    background-color: #FFFFFF;
    text-align: center;
    color: #2C3E50;
    border-radius: 6px;
}

QProgressBar::chunk {
    background-color: #3498DB;
    border-radius: 5px;
}

/* ====== CHECKBOX ====== */
QCheckBox {
    color: #2C3E50;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #95A5A6;
    background-color: #FFFFFF;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #3498DB;
    border: 1px solid #3498DB;
}

/* ====== ROUNDED SPINBOX ====== */
QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #BDC3C7;
    padding: 6px;
    color: #2C3E50;
    border-radius: 6px;
}

QSpinBox:focus {
    border: 1px solid #3498DB;
}

/* ====== LABELS ====== */
QLabel {
    color: #2C3E50;
    background-color: transparent;
}

QLabel#label_tips {
    background-color: #EBF5FB;
    border: 1px solid #D6EAF8;
    padding: 10px;
    color: #2874A6;
    border-radius: 6px;
}

/* ====== LEGIBLE QMESSAGEBOX ====== */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #2C3E50;
    background-color: transparent;
}

QMessageBox QPushButton {
    background-color: #3498DB;
    color: white;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
    font-weight: bold;
}

QMessageBox QPushButton:hover {
    background-color: #2980B9;
}

/* ====== LEGIBLE MENUS ====== */
QMenuBar {
    background-color: #FFFFFF;
}

QMenuBar::item {
    color: #2C3E50;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #3498DB;
    color: white;
    border-radius: 4px;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #BDC3C7;
}

QMenu::item {
    color: #2C3E50;
    background-color: transparent;
    padding: 8px 16px;
}

QMenu::item:selected {
    background-color: #3498DB;
    color: white;
    border-radius: 4px;
}
